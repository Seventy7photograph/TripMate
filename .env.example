RATE_LIMIT_BRIEF_PARSE_PER_MINUTE=12
RATE_LIMIT_PLANNING_PER_MINUTE=6
RATE_LIMIT_TRAVEL_CHAT_PER_MINUTE=12
SECURITY_HEADERS_ENABLED=true
ALLOW_PRIVATE_PROVIDER_URLS=false
PROVIDER_ALLOWED_HOSTS=
