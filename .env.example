MCP_WEATHER_ENDPOINT=
MCP_TIMEOUT_SECONDS=10
MCP_RATE_LIMIT_PER_MINUTE=60
MCP_DAILY_QUOTA_PER_CONNECTOR=1000
PROVIDER_TIMEOUT_SECONDS=5
PROVIDER_MAX_RETRIES=2
PLACE_CACHE_TTL_SECONDS=900
ROUTE_CACHE_TTL_SECONDS=900
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_REPAIRS=2
MODEL_CONFIG_DB_ENABLED=true
MODEL_CONFIG_ENCRYPTION_KEY=
PLANNING_TIMEOUT_SECONDS=120
PLANNING_MAX_TOOL_CALLS=12
PLANNING_MAX_LOOPS=2
PLANNING_MAX_COST_MINOR=1000
DAILY_USER_COST_LIMIT_MINOR=10000
DAILY_IP_COST_LIMIT_MINOR=30000
DAILY_PROVIDER_COST_LIMIT_MINOR=200000
COST_WARNING_RATIO=0.8
UPLOAD_DIR=output/uploads
MAX_IMAGE_UPLOAD_BYTES=5242880
MAX_DOCUMENT_UPLOAD_BYTES=10485760
MAX_UPLOADS_PER_MESSAGE=3
MAX_EXTRACTED_TEXT_CHARS=50000
MAX_IMAGE_PIXELS=20000000
